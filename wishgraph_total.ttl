###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#Case_GrandfatherHealthPrayer
:Case_GrandfatherHealthPrayer rdf:type owl:NamedIndividual ,
                                       :CyberRitualCase ;
                              :circulatesOn :Xiaohongshu ;
                              :employsSignifier :HundredIllnessesRetreatTalismanImg ;
                              :hasPerformativeAction :Posting_HealthTalismanPrayer ;
                              :resolvesIntoAffect :FamilyHealthRecovery ;
                              :transformedVia :DigitalTransposition_HealingTalisman ;
                              :triggeredBy :ExistentialPressure_FamilyIllness ;
                              rdfs:label "Grandfather Health Prayer Case"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#Case_GuanyinWishFulfillment
:Case_GuanyinWishFulfillment rdf:type owl:NamedIndividual ,
                                      :CyberRitualCase ;
                             :circulatesOn :Xiaohongshu ;
                             :employsSignifier :GuanyinWishImg ;
                             :hasPerformativeAction :Posting_GuanyinWish ;
                             :resolvesIntoAffect :RomanticFulfillment ;
                             :transformedVia :SacredAmplification_Guanyin ;
                             :triggeredBy :MundanePressure_RomanticFutureUncertainty ;
                             rdfs:label "Guanyin Wish Fulfillment Case"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#Case_HealthWish
:Case_HealthWish rdf:type owl:NamedIndividual ,
                          :CyberRitualCase ;
                 :circulatesOn :Xiaohongshu ;
                 :employsSignifier :BlueBuddhaImg ;
                 :hasPerformativeAction :Posting_HealthWish ;
                 :resolvesIntoAffect :HealthRecovery ;
                 :transformedVia :RestoreOriginal ;
                 :triggeredBy :HealthProblem ;
                 :hasSourceURL "https://xhslink.cn/o/7EqcM3TCMbO" ;
                 rdfs:comment "A cyber-wishing case in which a user posts or engages with a Medicine Buddha image in response to health-related anxiety."@en ;
                 rdfs:label "Medicine Buddha Health Wish Case"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#Case_InstagramTraditionalPrayer
:Case_InstagramTraditionalPrayer rdf:type owl:NamedIndividual ,
                                          :CyberRitualCase ;
                                 :circulatesOn :Instagram ;
                                 :employsSignifier :TraditionalBuddhaPostImage ;
                                 :hasPerformativeAction :Posting_NewYearPrayer ;
                                 :resolvesIntoAffect :NewYearVibes ;
                                 :transformedVia :RestoreOriginal ;
                                 :triggeredBy :MundanePressure_FutureUncertainty ;
                                 :hasSourceURL "https://www.instagram.com/p/DaiKtLrEve2/?stkn=MTY3NGp1dHl2cnp5dg==" ;
                                 rdfs:comment "A cyber-ritual case where a user posts a traditional, unedited image of Buddha on Instagram to pray for positive energy and good news for the upcoming year."@en ;
                                 rdfs:label "Instagram Traditional Buddha Prayer Case"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#Case_InstagramWealth
:Case_InstagramWealth rdf:type owl:NamedIndividual ,
                               :CyberRitualCase ;
                      :circulatesOn :Instagram ;
                      :employsSignifier :SportsCarManifestingVideo ;
                      :hasPerformativeAction :Commenting_ClaimWealth ,
                                             :Posting_WealthManifesting ;
                      :resolvesIntoAffect :FinancialFreedom ;
                      :transformedVia :Remediation_LuxuryCar ;
                      :triggeredBy :MundanePressure_StatusAnxiety ;
                      rdfs:comment "A cyber-ritual case where a user posts a highly aestheticized sports car video to manifest financial freedom and relieve status anxiety."@en ;
                      rdfs:label "Instagram Wealth Manifesting Case"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#Case_ManifestingKardashian
:Case_ManifestingKardashian rdf:type owl:NamedIndividual ,
                                     :CyberRitualCase ;
                            :circulatesOn :Xiaohongshu ;
                            :employsSignifier :KrisJennerMemeImg ;
                            :hasPerformativeAction :Posting_ManifestingSpell ;
                            :resolvesIntoAffect :WealthDelusion ;
                            :transformedVia :PopIdolGod ;
                            :triggeredBy :CareerWealth ;
                            :hasSourceURL "https://xhslink.cn/o/2r8I5Se4tQR" ;
                            rdfs:comment "A cyber-ritual case where a user posts a Kris Jenner meme to manifest wealth, career success, and multi-identities."@en ;
                            rdfs:label "Manifesting Kardashian Case"@en .


