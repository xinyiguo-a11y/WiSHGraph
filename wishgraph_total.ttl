###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#Case_XiaohongshuCET6Comment
:Case_XiaohongshuCET6Comment rdf:type owl:NamedIndividual ,
                                      :CyberRitualCase ;
                             :circulatesOn :Xiaohongshu ;
                             :employsSignifier :KrisJennerReplyImage ;
                             :hasPerformativeAction :Commenting_CET6Manifestation ;
                             :resolvesIntoAffect :AcademicSuccess ;
                             :transformedVia :PopIdolGod ;
                             :triggeredBy :ExamPressure ;
                             rdfs:comment "A micro-ritual case where a user comments with a Kris Jenner image and a manifesting text to pass an English exam."@en ;
                             rdfs:label "Xiaohongshu CET-6 Comment Case"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#CashManifestingVideo
:CashManifestingVideo rdf:type owl:NamedIndividual ,
                               :VideoSignifier ;
                      :containsSymbol :Emoji_RedHeart ;
                      :remediates :StackOfCash ;
                      rdfs:comment "The digital remediated video signifier displaying the luxury atmosphere and cash to act as the core icon of the ritual."@en ;
                      rdfs:label "Cash Manifesting Video"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#CashStacks
:CashStacks rdf:type owl:NamedIndividual ,
                     :VisualOrAuditoryMarker ;
            rdfs:label "Cash Stacks"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#Cat
:Cat rdf:type owl:NamedIndividual ,
              :Animal ;
     rdfs:comment "A domestic animal archetype used as the source figure for a playful Buddha-like digital signifier."@en ;
     rdfs:label "Cat Archetype"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#CatBuddha
:CatBuddha rdf:type owl:NamedIndividual ,
                    :SacredHybridization ;
           rdfs:comment "An animal memeification strategy in which a cat is visually and symbolically transformed into a Buddha-like wishing figure."@en ;
           rdfs:label "Cat Buddha Remediation"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#CloudAesthetic
:CloudAesthetic rdf:type owl:NamedIndividual ,
                         :VisualOrAuditoryMarker ;
                rdfs:label "Cloud Aesthetic"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#Commenting_CET6Manifestation
:Commenting_CET6Manifestation rdf:type owl:NamedIndividual ,
                                       :CommentingAction ;
                              creon:hasPart :KrisJennerReplyImage ,
                                            :Mantra_CET6Success ;
                              :performedBy :CET6Commenter ;
                              rdfs:comment "The performative digital act of replying to a manifesting post with a specific text and a pop-idol image to hijack or share the ritual's power."@en ;
                              rdfs:label "Commenting CET-6 Manifestation"@en .


###  http://www.ontologydesignpatterns.org/ont/cyberwishing/cw.owl#Commenting_ClaimWealth
