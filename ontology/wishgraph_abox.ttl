@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

############################################################
# Cyber-ritual cases
############################################################

cw:Case_CatWish a cw:CyberRitualCase , owl:NamedIndividual ;
    rdfs:label "Cat Buddha Exam Wish Case"@en ;
    rdfs:comment "A cyber-ritual case circulating on Xiaohongshu Platform, triggered by Exam Pressure and resolving into Meme Therapy."@en ;
    cw:circulatesOn cw:Xiaohongshu ;
    cw:employsSignifier cw:ExamCatImg ;
    cw:hasPerformativeAction cw:Posting_ExamWish ;
    cw:resolvesIntoAffect cw:MemeTherapy ;
    cw:transformedVia cw:CatBuddha ;
    cw:triggeredBy cw:ExamPressure .

cw:Case_DigitalEnlightenment a cw:CyberRitualCase , owl:NamedIndividual ;
    rdfs:label "Digital Enlightenment Case"@en ;
    rdfs:comment "A cyber-ritual case circulating on Douyin Platform, triggered by Modern Anxiety and Existential Pressure and resolving into Sincere Hope for Inner Peace."@en ;
